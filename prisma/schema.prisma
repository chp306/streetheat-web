// ============================================================
//  STREETHEAT — Database Schema v1
//  Phase 6 implementation
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
//  USERS & AUTH
// ============================================================

enum UserRole {
  customer
  admin
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  role                 UserRole  @default(customer)
  referralCode         String    @unique
  referredByUserId     String?
  referralRewardedAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  referredBy           User?              @relation("Referrals", fields: [referredByUserId], references: [id])
  referredUsers        User[]             @relation("Referrals")
  addresses            Address[]
  orders               Order[]
  offers               Offer[]
  wishlistItems        WishlistItem[]
  loyaltyAccount       LoyaltyAccount?

  @@index([email])
  @@index([referralCode])
}

model Address {
  id          String  @id @default(uuid())
  userId      String
  label       String
  line1       String
  line2       String?
  city        String
  postcode    String
  country     String  @default("UK")
  isDefault   Boolean @default(false)

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
}

// ============================================================
//  CATALOGUE
// ============================================================

enum ProductCondition {
  new
  used_like_new
  used_good
  used_fair
}

enum ProductStatus {
  draft
  published
  archived
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String
  brandId         String
  categoryId      String
  condition       ProductCondition
  basePrice       Decimal          @db.Decimal(10, 2)
  lastSalePrice   Decimal?         @db.Decimal(10, 2)
  status          ProductStatus    @default(draft)
  offerEnabled    Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  brand           Brand            @relation(fields: [brandId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  wishlistItems   WishlistItem[]

  @@index([status])
  @@index([brandId])
  @@index([categoryId])
}

model ProductVariant {
  id              String      @id @default(uuid())
  productId       String
  size            String
  stockQuantity   Int         @default(0)
  sku             String      @unique

  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  offers          Offer[]

  @@index([productId])
}

model ProductImage {
  id            String   @id @default(uuid())
  productId     String
  url           String
  displayOrder  Int      @default(0)

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================
//  ORDERS
// ============================================================

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
  refunded
}

model Order {
  id                      String       @id @default(uuid())
  userId                  String
  status                  OrderStatus  @default(pending)
  subtotal                Decimal      @db.Decimal(10, 2)
  shippingCost            Decimal      @db.Decimal(10, 2)
  discountAmount          Decimal      @db.Decimal(10, 2) @default(0)
  total                   Decimal      @db.Decimal(10, 2)
  promoCodeId             String?
  shippingAddressId       String
  loyaltyPointsEarned     Int          @default(0)
  loyaltyPointsRedeemed   Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  user                    User             @relation(fields: [userId], references: [id])
  shippingAddress         Address          @relation(fields: [shippingAddressId], references: [id])
  promoCode               PromoCode?       @relation(fields: [promoCodeId], references: [id])
  items                   OrderItem[]
  payment                 Payment?
  shippingLabel           ShippingLabel?
  loyaltyTransactions     LoyaltyTransaction[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  productVariantId  String
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  isOfferPrice      Boolean         @default(false)

  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant  @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
}

// ============================================================
//  PAYMENTS & SHIPPING
// ============================================================

enum PaymentProvider {
  stripe
  paypal
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model Payment {
  id                  String           @id @default(uuid())
  orderId             String           @unique
  provider            PaymentProvider
  providerPaymentId   String
  amount              Decimal          @db.Decimal(10, 2)
  status              PaymentStatus    @default(pending)
  createdAt           DateTime         @default(now())

  order               Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingLabel {
  id              String   @id @default(uuid())
  orderId         String   @unique
  carrier         String   @default("Royal Mail")
  trackingNumber  String?
  labelUrl        String?
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============================================================
//  OFFERS
// ============================================================

enum OfferStatus {
  pending
  accepted
  rejected
  countered
  expired
}

model Offer {
  id                String       @id @default(uuid())
  userId            String
  productVariantId  String
  offerPrice        Decimal      @db.Decimal(10, 2)
  listedPrice       Decimal      @db.Decimal(10, 2)
  status            OfferStatus  @default(pending)
  counterPrice      Decimal?     @db.Decimal(10, 2)
  checkoutToken     String?      @unique
  tokenExpiresAt    DateTime?
  respondedAt       DateTime?
  createdAt         DateTime     @default(now())

  user              User             @relation(fields: [userId], references: [id])
  productVariant    ProductVariant   @relation(fields: [productVariantId], references: [id])

  @@index([userId])
  @@index([status])
}

// ============================================================
//  WISHLIST
// ============================================================

model WishlistItem {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ============================================================
//  LOYALTY
// ============================================================

enum LoyaltyReason {
  purchase
  referral
  redemption
  adjustment
}

model LoyaltyTier {
  id                String           @id @default(uuid())
  name              String           @unique
  minPoints         Int
  perksDescription  String

  accounts          LoyaltyAccount[]
}

model LoyaltyAccount {
  id              String   @id @default(uuid())
  userId          String   @unique
  pointsBalance   Int      @default(0)
  lifetimePoints  Int      @default(0)
  currentTierId   String

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTier     LoyaltyTier            @relation(fields: [currentTierId], references: [id])
  transactions    LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id                  String         @id @default(uuid())
  loyaltyAccountId    String
  orderId             String?
  pointsChange        Int
  reason              LoyaltyReason
  createdAt           DateTime       @default(now())

  loyaltyAccount      LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  order               Order?         @relation(fields: [orderId], references: [id])

  @@index([loyaltyAccountId])
}

// ============================================================
//  PROMO CODES
// ============================================================

enum PromoDiscountType {
  percentage
  fixed
}

model PromoCode {
  id              String             @id @default(uuid())
  code            String             @unique
  discountType    PromoDiscountType
  discountValue   Decimal            @db.Decimal(10, 2)
  minOrderValue   Decimal?           @db.Decimal(10, 2)
  usageLimit      Int?
  timesUsed       Int                @default(0)
  expiresAt       DateTime?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())

  orders          Order[]
}
